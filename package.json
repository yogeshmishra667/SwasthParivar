{
  "name": "swasth-parivar",
  "private": true,
  "version": "0.1.0",
  "description": "Chronic condition health companion for Indian families.",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r --filter=./packages/* run build && pnpm -r --filter=./apps/* run build",
    "dev": "pnpm -r --parallel run dev",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration",
    "typecheck": "pnpm -r --parallel run typecheck",
    "lint": "pnpm -r --parallel run lint",
    "lint:fix": "pnpm -r --parallel run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "test": "pnpm -r --parallel run test",
    "test:unit": "pnpm --filter=@swasth/domain-logic run test",
    "test:integration": "pnpm --filter=@swasth/server run test:integration",
    "test:coverage": "pnpm -r --parallel run test:coverage",
    "clean": "pnpm -r run clean && rm -rf node_modules",
    "new-module": "bash scripts/scaffold/new-module.sh",
    "new-detector": "bash scripts/scaffold/new-detector.sh",
    "new-migration": "bash scripts/scaffold/new-migration.sh",
    "prepare": "husky"
  },
  "pnpm": {
    "overrides": {
      "@nozbe/with-observables>react": "*",
      "@nozbe/with-observables>@types/react": "*",
      "semver": "^7.7.4",
      "@xmldom/xmldom": "^0.8.15",
      "fast-uri": "^3.1.9",
      "fast-xml-builder": "^1.1.7",
      "protobufjs": "^7.6.6",
      "@protobufjs/utf8": "^1.1.1",
      "form-data@>=4.0.0 <4.0.6": "^4.0.6",
      "form-data@>=2.0.0 <2.5.6": "^2.5.6",
      "undici@<6.28.1": "^6.29.1",
      "ip-address": "^10.7.4",
      "uuid": "^11.1.1",
      "tmp": "^0.2.7",
      "qs": "^6.16.1",
      "postcss": "^8.5.31",
      "@hono/node-server": "^1.19.17",
      "@babel/runtime": "^7.26.10",
      "ws": "^8.20.1",
      "cookie": "^0.7.0",
      "shell-quote": "^1.12.0",
      "@grpc/grpc-js": "^1.14.6",
      "hono": "^4.13.13",
      "proxy-addr": "^2.0.8",
      "@fastify/busboy": "^3.2.3",
      "mysql2": "^3.24.6",
      "seroval": "^1.6.11",
      "seroval-plugins": "^1.6.11",
      "tar@^7": "^7.5.22",
      "websocket-driver": "^0.7.5",
      "brace-expansion@^1": "^1.1.21",
      "brace-expansion@^2": "^2.1.7",
      "brace-expansion@^5": "^5.0.12",
      "browserslist": "^4.29.4",
      "compression": "^1.8.2",
      "joi": "^17.13.8",
      "js-yaml@^3": "^3.15.2",
      "js-yaml@^4": "^4.3.2",
      "nanoid@^3": "^3.3.20",
      "source-map-js": "^1.2.2",
      "valibot": "^1.5.0",
      "body-parser@^2": "^2.4.0",
      "postcss-selector-parser@^6": "^6.1.5",
      "follow-redirects": "^1.16.1",
      "undici@^7": "^7.30.1",
      "esbuild@^0.28": "^0.28.2",
      "@humanfs/node": "^0.16.8",
      "fast-copy@^4": "^4.3.0",
      "deepmerge-ts": "^8.0.2"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-86w9-cpqp-85rv",
        "GHSA-5p2g-fcmc-qvqq",
        "GHSA-w3rx-r6r6-pgpr",
        "GHSA-vcc3-ghjq-m6fr"
      ]
    }
  },
  "dependencies": {
    "semver": "^7.7.4"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/node": "^20.14.10",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-security": "^4.0.0",
    "husky": "9.1.7",
    "lint-staged": "^16",
    "prettier": "^3.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12"
  }
}
